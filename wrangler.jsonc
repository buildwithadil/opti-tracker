{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "optidesk",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "optidesk",
      "migrations_dir": "migrations"
    },
    {
      "binding": "optidesk_staging",
      "database_name": "optidesk-staging",
      "database_id": "5fc6c1c4-c43a-4b59-a606-18fbadc22a5d",
      "remote": true
    }
  ],
  "triggers": { "crons": ["0 19 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "env": {
    "staging": {
      "name": "optidesk-staging",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "optidesk-staging",
          "database_id": "5fc6c1c4-c43a-4b59-a606-18fbadc22a5d",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "triggers": { "crons": ["0 19 * * *"] },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1,
        "redact_query_string": true,
        "logs": { "invocation_logs": false },
        "traces": { "enabled": false }
      }
    }
  }
}
